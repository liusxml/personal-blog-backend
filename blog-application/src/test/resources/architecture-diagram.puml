@startuml
!theme plain

' ==========================================
' Personal Blog Backend Architecture Diagram
' 使用 ArchUnit 可识别的语法
' ==========================================

' Common 层 - 公共组件
component [blog-common] <<com.blog.common..>> as common

' API 层 (契约层) - 使用 package stereotype
component [blog-system-api] <<com.blog.system.api..>> as sysApi
component [blog-article-api] <<com.blog.article.api..>> <<com.blog.article.dto..>> <<com.blog.article.vo..>> as artApi
component [blog-comment-api] <<com.blog.comment.api..>> as cmtApi
component [blog-file-api] <<com.blog.file.api..>> as fileApi
component [blog-ai-api] <<com.blog.ai.api..>> as aiApi

' Service 层 (实现层)
component [blog-system-service] <<com.blog.system.controller..>> <<com.blog.system.service..>> <<com.blog.system.domain..>> <<com.blog.system.infrastructure..>> <<com.blog.system.constant..>> as sysSvc
component [blog-article-service] <<com.blog.article.controller..>> <<com.blog.article.service..>> <<com.blog.article.domain..>> <<com.blog.article.infrastructure..>> <<com.blog.article.metrics..>> as artSvc
component [blog-comment-service] <<com.blog.comment.controller..>> <<com.blog.comment.service..>> <<com.blog.comment.domain..>> <<com.blog.comment.infrastructure..>> <<com.blog.comment.metrics..>> as cmtSvc
component [blog-file-service] <<com.blog.file.controller..>> <<com.blog.file.service..>> <<com.blog.file.domain..>> <<com.blog.file.infrastructure..>> <<com.blog.file.validator..>> as fileSvc
component [blog-ai-service] <<com.blog.ai.controller..>> <<com.blog.ai.service..>> <<com.blog.ai.domain..>> <<com.blog.ai.infrastructure..>> <<com.blog.ai.application..>> <<com.blog.ai.config..>> as aiSvc

' Application 层
component [blog-application] <<com.blog.application..>> <<com.blog.config..>> <<com.blog.handler..>> <<com.blog.security..>> <<com.blog.service..>> <<com.blog.event..>> <<com.blog.util..>> as app

' ==========================================
' 依赖关系定义（允许的依赖）
' ==========================================

' Service -> 自己的 API
sysSvc --> sysApi : uses
artSvc --> artApi : uses
cmtSvc --> cmtApi : uses
fileSvc --> fileApi : uses
aiSvc --> aiApi : uses

' Service -> Common
sysSvc --> common : uses
artSvc --> common : uses
cmtSvc --> common : uses
fileSvc --> common : uses
aiSvc --> common : uses

' 跨模块调用 (Service -> 其他 API)
artSvc --> sysApi : <<cross-module>>
artSvc --> fileApi : <<cross-module>>
artSvc --> aiApi : <<cross-module>>
cmtSvc --> artApi : <<cross-module>>
cmtSvc --> sysApi : <<cross-module>>

' API -> Common
sysApi --> common : uses
artApi --> common : uses
cmtApi --> common : uses
fileApi --> common : uses
aiApi --> common : uses

' Application -> Common / API / Service 模块
app --> common : uses
app --> sysApi : uses
app --> artApi : uses
app --> cmtApi : uses
app --> fileApi : uses
app --> aiApi : uses
app --> sysSvc : uses
app --> artSvc : uses
app --> cmtSvc : uses
app --> fileSvc : uses
app --> aiSvc : uses

note right of sysSvc
    <b>架构规则</b>
    ✅ Service 可以访问自己的 API
    ✅ Service 可以访问 Common
    ✅ Service 可以访问其他模块的 API
    ❌ Service 不能访问其他 Service
end note

@enduml
